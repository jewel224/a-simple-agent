# 本机开发环境模板，复制为 .env 后填写真实密码
# .env 已被 .gitignore 忽略，不会进入源码分享

MOCK_PG_SUPER_PASSWORD=你的 postgres 超级用户密码
MOCK_PG_APP_PASSWORD=你的应用角色密码
MOCK_PG_RO_PASSWORD=你的 shop_ro 密码

MOCK_PG_HOST=localhost
MOCK_PG_PORT=5432
MOCK_PG_USER=shop_app
MOCK_PG_PASSWORD=你的 shop_app 密码
MOCK_PG_DB=shop_dw

EMBEDDING_PG_DB=embedding_store
EMBEDDING_PG_USER=embed_app
EMBEDDING_PG_PASSWORD=你的 embed_app 密码

MEMORY_PG_DB=agent_memory
MEMORY_PG_USER=memory_app
MEMORY_PG_PASSWORD=你的 memory_app 密码

OP_LOG_DB=op_log
OP_LOG_USER=log_app
OP_LOG_PASSWORD=你的 log_app 密码

DASHSCOPE_API_KEY=你的 DashScope API Key
QWEN_MODEL=qwen-turbo
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSION=1024

APP_API_KEY=你的 API 访问密钥
GOVERNED_SQL_TIMEOUT_MS=3000
GOVERNED_SQL_MAX_ROWS=100

SEMANTIC_TABLE_LIMIT=6
SEMANTIC_COLUMN_LIMIT=20
SEMANTIC_METRIC_LIMIT=6
SEMANTIC_EXAMPLE_LIMIT=3
MEMORY_MESSAGE_LIMIT=10
